{
  "name": "wfx-smart-site",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "python ../scripts/export_site_content.py",
    "dev": "npm run content && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply wfx-smart-db --remote",
    "deploy": "npm run content && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
