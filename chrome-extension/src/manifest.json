{
  "manifest_version": 3,
  "name": "WFX Smart Automation",
  "description": "WFX Catalog automation, quick search, hotkey and login panel without Tampermonkey.",
  "version": "1.9.1",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://prosports.worldfashionexchange.com/*"
  ],
  "action": {
    "default_title": "WFX Smart Automation",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "description": "Mở hoặc đóng WFX Smart panel"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://prosports.worldfashionexchange.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://prosports.worldfashionexchange.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
